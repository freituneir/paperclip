+// Paperclip: Claude Agent SDK options carried from the claude_local adapter in
+// PAPERCLIP_CLAUDE_SDK_OPTIONS_JSON (company Claude Home setting sources,
+// settings overlay, strict MCP, fallback model, tool lists, extra CLI args).
+// Only an allowlisted set of keys is honored; absence or bad JSON yields {}.
+const PAPERCLIP_CLAUDE_SDK_OPTION_KEYS = [
+    "settingSources",
+    "settings",
+    "strictMcpConfig",
+    "fallbackModel",
+    "allowedTools",
+    "disallowedTools",
+    "extraArgs",
+];
+function readPaperclipClaudeSdkOptions() {
+    const raw = process.env.PAPERCLIP_CLAUDE_SDK_OPTIONS_JSON;
+    if (!raw)
+        return {};
+    try {
+        const parsed = JSON.parse(raw);
+        if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
+            return {};
+        const picked = {};
+        for (const key of PAPERCLIP_CLAUDE_SDK_OPTION_KEYS) {
+            if (parsed[key] !== undefined && parsed[key] !== null)
+                picked[key] = parsed[key];
+        }
+        return picked;
+    }
+    catch {
+        return {};
+    }
+}
